  "info": {
    "title": "Run Orchestrator Task Database API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/outputs": {
      "get": {
        "description": "List available output configurations with optional grouping.",
        "operationId": "list_outputs_api_outputs_get",
        "parameters": [
          {
            "in": "query",
            "name": "group_mode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Group Mode"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputsListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Outputs"
      }
    },
    "/api/outputs/{configuration}": {
      "get": {
        "description": "Return detailed information and transcripts for a configuration.",
        "operationId": "get_output_configuration_api_outputs__configuration__get",
        "parameters": [
          {
            "in": "path",
            "name": "configuration",
            "required": true,
            "schema": {
              "title": "Configuration",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Output Configuration"
      }
    },
    "/api/outputs/{configuration}/stats": {
      "get": {
        "description": "Return debate statistics for an evaluation configuration.",
        "operationId": "get_output_configuration_stats_api_outputs__configuration__stats_get",
        "parameters": [
          {
            "in": "path",
            "name": "configuration",
            "required": true,
            "schema": {
              "title": "Configuration",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputStatsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Output Configuration Stats"
      }
    },
    "/health": {
      "get": {
        "description": "Simple health endpoint to confirm the API is responsive.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Check Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/runs": {
      "get": {
        "description": "Return all recorded runs along with their subtasks ordered by recency.",
        "operationId": "list_runs_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunWithSubtasksResponse"
                  },
                  "title": "Response List Runs Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Runs"
      }
    },
    "/runs/{run_id}": {
      "get": {
        "description": "Return a single run and its associated subtasks.",
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run"
      }
    },
    "/runs/{run_id}/processes": {
      "get": {
        "description": "Return remote process metadata for each subtask associated with a run.",
        "operationId": "list_run_processes_runs__run_id__processes_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "integer"
            }
