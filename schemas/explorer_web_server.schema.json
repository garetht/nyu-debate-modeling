{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RunDetailResponse": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/RunTaskResponse"
          },
          "subtasks": {
            "items": {
              "$ref": "#/components/schemas/RunSubtaskResponse"
            },
            "title": "Subtasks",
            "type": "array"
          }
        },
        "required": [
          "run",
          "subtasks"
        ],
        "title": "RunDetailResponse",
        "type": "object"
      },
      "RunSubtaskResponse": {
        "properties": {
          "base_task_name": {
            "title": "Base Task Name",
            "type": "string"
          },
          "command": {
            "title": "Command",
            "type": "string"
          },
          "configuration": {
            "title": "Configuration",
            "type": "object"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "ip_address": {
            "title": "Ip Address",
            "type": "string"
          },
          "log_path": {
            "title": "Log Path",
            "type": "string"
          },
          "logs_command": {
            "title": "Logs Command",
            "type": "string"
          },
          "resolved_task_name": {
            "title": "Resolved Task Name",
            "type": "string"
          },
          "run_task_id": {
            "title": "Run Task Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "run_task_id",
          "base_task_name",
          "resolved_task_name",
          "ip_address",
          "command",
          "log_path",
          "configuration",
          "created_at",
          "logs_command"
        ],
        "title": "RunSubtaskResponse",
        "type": "object"
      },
      "RunTaskResponse": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "run_name": {
            "title": "Run Name",
            "type": "string"
          },
          "yaml_path": {
            "title": "Yaml Path",
            "type": "string"
          }
        },
        "required": [
          "id",
          "run_name",
          "yaml_path",
          "created_at"
        ],
        "title": "RunTaskResponse",
        "type": "object"
      },
      "RunWithSubtasksResponse": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "run_name": {
            "title": "Run Name",
            "type": "string"
          },
          "subtasks": {
            "items": {
              "$ref": "#/components/schemas/RunSubtaskResponse"
            },
            "title": "Subtasks",
            "type": "array"
          },
          "yaml_path": {
            "title": "Yaml Path",
            "type": "string"
          }
        },
        "required": [
          "id",
          "run_name",
          "yaml_path",
          "created_at",
          "subtasks"
        ],
        "title": "RunWithSubtasksResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Run Orchestrator Task Database API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Simple health endpoint to confirm the API is responsive.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Check Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/runs": {
      "get": {
        "description": "Return all recorded runs along with their subtasks ordered by recency.",
        "operationId": "list_runs_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunWithSubtasksResponse"
                  },
                  "title": "Response List Runs Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Runs"
      }
    },
    "/runs/{run_id}": {
      "get": {
        "description": "Return a single run and its associated subtasks.",
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run"
      }
    },
    "/runs/{run_id}/subtasks": {
      "get": {
        "description": "Return subtasks for a specific run.",
        "operationId": "list_run_subtasks_runs__run_id__subtasks_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSubtaskResponse"
                  },
                  "title": "Response List Run Subtasks Runs  Run Id  Subtasks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Run Subtasks"
      }
    },
    "/subtasks": {
      "get": {
        "description": "Return all subtasks, optionally filtered by run identifier.",
        "operationId": "list_subtasks_subtasks_get",
        "parameters": [
          {
            "in": "query",
            "name": "run_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSubtaskResponse"
                  },
                  "title": "Response List Subtasks Subtasks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Subtasks"
      }
    }
  }
}
